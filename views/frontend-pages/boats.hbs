<div class="container-fluid">
    <div class="row">
        {{#each boats}}

        <div class="col-lg-4">
            <div class="boats-image">
                <a href="">
                    <img src="{{this.productImage}}" alt="{{this.boatTitle}}">
                </a>
            </div>
            <div class="boat-card-body">
                <h3 class="boat-card-title"><a href="">{{this.boatTitle}}</a></h3>
                <p class="boat-card-price">Price: {{this.salePrice}}</p>
            </div>
        </div>

        {{/each}}
    </div>
</div>