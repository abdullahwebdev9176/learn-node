<div class="container-fluid">
    <div class="row">
        {{#each boats}}

        <div class="col-lg-4">
            <div class="boats-image">
                <a href="">
                    <img src="{{this.productImage}}" alt="{{this.boatTitle}}">
                </a>
            </div>
            <div>
                <h3><a href="">{{this.boatTitle}}</a></h3>
                <p>Price: {{this.salePrice}}</p>
            </div>
        </div>

        {{/each}}
    </div>
</div>