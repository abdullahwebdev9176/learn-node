<section class="py-5">
    <div class="container-fluid">
    <div class="row">
        <div class="col-9 mx-auto">
            <form action="">
                <div class="form-group mb-3">
                    <label for="slider-title">Slider Title</label>
                    <input type="text" id="slider-title" name="slider-title" class="form-control"
                        placeholder="Enter slider title">
                </div>
                <div class="form-group mb-3">
                    <label for="slider-image">Slider Image</label>
                    <input type="file" id="slider-image" name="slider-image" class="form-control">
                </div>
                <div class="form-group mb-3">
                    <label for="slider-link">Slider Link</label>
                    <input type="url" id="slider-link" name="slider-link" class="form-control"
                        placeholder="Enter slider link URL">
                </div>

                <button type="submit" class="btn btn-primary">Add Slider</button>

            </form>
        </div>
    </div>
</div>
</section>