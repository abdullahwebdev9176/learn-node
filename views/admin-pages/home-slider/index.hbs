<div class="container-fluid">
    <div class="row">
        <div class="col-xl-9 mx-auto">
            <h2 class="admin-page-title">Home Slider List</h2>

            <table class="table table-bordered table-hover mt-4">
                <tr>
                    <th>Title</th>
                    <th>Delete</th>
                    <th>Edit</th>
                </tr>

                {{#each sliders}}
                <tr>
                    <td>{{this.title}}</td>
                    <td>
                        <a class="btn btn-danger" href="/admin/home-slider/delete/{{this._id}}">Delete</a>
                    </td>
                    <td>
                        <a class="btn btn-primary" href="/admin/home-slider/edit/{{this._id}}">Edit</a>
                    </td>
                </tr>
                {{/each}}
            </table>
        </div>
    </div>
</div>