<section class="pt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-9 mx-auto">

                <div class="d-flex justify-content-between align-items-center my-4">
                    <h2 class="admin-page-title">Update Slide</h2>
                    <a href="/admin/home-slider/create" class="btn btn-primary">Add New Slider</a>
                </div>

                <form action="/admin/home-slider/update/{{slider._id}}" method="POST" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label>Slider Title</label>
                        <input type="text" name="title" class="form-control" value="{{slider.title}}"
                            placeholder="Enter slider title" required>
                    </div>

                    <div class="form-group mb-3">
                        <label>Slider Image</label>
                        <input type="file" name="image" class="form-control">
                    </div>

                    <div class="form-group mb-3">
                        <label>Slider Link</label>
                        <input type="url" name="link" class="form-control" value="{{slider.link}}"
                            placeholder="Enter slider link URL">
                    </div>

                    <button type="submit" class="btn btn-primary">Update Slide</button>
                </form>
            </div>
        </div>
    </div>
</section>