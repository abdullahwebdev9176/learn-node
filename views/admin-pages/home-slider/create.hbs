<section class="pt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-9 mx-auto">
                <form action="/admin/home-slider/store" method="POST" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label>Slider Title</label>
                        <input type="text" name="title" class="form-control" placeholder="Enter slider title" required>
                    </div>

                    <div class="form-group mb-3">
                        <label>Slider Image</label>
                        <input type="file" name="image" class="form-control" required>
                    </div>

                    <div class="form-group mb-3">
                        <label>Slider Link</label>
                        <input type="url" name="link" class="form-control" placeholder="Enter slider link URL">
                    </div>

                    <button type="submit" class="btn btn-primary">Add Slide</button>
                </form>
            </div>
        </div>
    </div>
</section>